<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress expected error logs from tests that intentionally test error handling -->
    <!-- These errors are expected and part of the test scenarios -->
    <logger name="com.aaami.product.service.ProductEventProducer" level="OFF"/>
    <logger name="com.aaami.product.service.ProductCacheService" level="OFF"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

